# OpenAI-compatible LLM configuration. MemoryOS targets OpenRouter
# (an OpenAI-compatible provider). An API key is required only for AI
# answering; the local memory engine works without it.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
# Cosine distance cutoff (0-2, lower = more similar) for memories to be
# considered relevant and passed to the LLM. Defaults to 0.75 when unset.
MEMORY_DISTANCE_THRESHOLD=

# Related-memory suggestions (Knowledge Map) are shown while the cosine
# distance stays at or below RELATED_DISTANCE_THRESHOLD. Defaults to 0.80.
RELATED_DISTANCE_THRESHOLD=

# Conflict detection tuning (optional). CONFLICT_PAIR_DISTANCE controls how
# closely two memories must sit for their recommendations to be compared
# (default 0.55). CONFLICT_REC_DIFF is the minimum dissimilarity between two
# recommendations before they become a conflict candidate (default 0.35).
CONFLICT_PAIR_DISTANCE=
CONFLICT_REC_DIFF=